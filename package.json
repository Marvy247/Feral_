{
  "name": "feral",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Feral - the security layer for autonomous money on NEAR: 20 policy checks (17 enforced on-chain), adaptive reputation, anomaly detection, circuit breakers and timelocked governance.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "preflight": "node scripts/preflight.ts",
    "preflight:offline": "node scripts/preflight.ts --offline",
    "test": "node --test-isolation=none --test \"test/unit/*.test.ts\"",
    "test:all": "node --test-isolation=none --test \"test/**/*.test.ts\"",
    "mvp": "node src/cli/mvp.ts",
    "story": "node src/cli/story.ts",
    "agent": "node src/cli/agent.ts",
    "agent:attack": "node src/cli/agent-attack.ts",
    "blocklist:attack": "node src/cli/blocklist-attack.ts",
    "bench": "node scripts/bench.ts",
    "audit:docs": "node scripts/audit-docs.ts",
    "demo": "node src/cli/feral.ts demo",
    "demo:judge": "node src/cli/feral.ts demo:judge",
    "demo:build": "node scripts/build-demo.ts",
    "demo:check": "node scripts/build-demo.ts --check",
    "caps:gen": "node scripts/gen-capabilities.ts",
    "caps:check": "node scripts/gen-capabilities.ts --check",
    "verify:claims": "node scripts/verify-claims.ts",
    "attack": "node src/cli/feral.ts attack",
    "verify": "node src/cli/feral.ts verify",
    "simulate": "node src/cli/feral.ts simulate",
    "reputation": "node src/cli/feral.ts reputation",
    "anomaly": "node src/cli/feral.ts anomaly",
    "quote": "node src/cli/feral.ts quote",
    "chainsig": "node src/cli/feral.ts chainsig",
    "quote:capture": "node src/cli/capture.ts",
    "serve": "node src/app/server.ts",
    "dashboard": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "npm --prefix dashboard run start",
    "audit": "node src/cli/feral.ts audit verify",
    "chain:account": "node scripts/testnet-account.ts",
    "chain:demo": "node scripts/testnet-demo.ts",
    "chain:agent-attack": "node scripts/testnet-agent-attack.ts",
    "chain:mpc": "node scripts/testnet-mpc-sign.ts",
    "chain:daily": "node scripts/testnet-daily-cap.ts",
    "chain:ft": "node scripts/testnet-ft.ts",
    "chain:rotate": "node scripts/testnet-rotate-agent.ts",
    "chain:topup": "node scripts/testnet-topup.ts",
    "chain:conformance": "node scripts/testnet-conformance.ts",
    "chain:show": "node scripts/show-testnet-run.ts"
  },
  "devDependencies": {
    "near-api-js": "^7.3.1"
  }
}
